# Copy to .env.local and fill in the business's real details before deploying.

# WhatsApp number in international format, digits only (e.g. 91XXXXXXXXXX). Required for production.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public phone number shown in the footer, e.g. +91 XXXXX XXXXX (optional)
NEXT_PUBLIC_PHONE=

# Public email address (optional)
NEXT_PUBLIC_EMAIL=

# Canonical site URL, used for SEO metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Social profiles (optional — links render only when set)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
